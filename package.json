{
  "name": "pet-seen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test tests/e2e/core-beta.spec.ts tests/e2e/found-pet-lifecycle.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:e2e:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:e2e:update": "npm run test:e2e:visual:update",
    "test:e2e:all": "playwright test",
    "test:unit": "vitest run tests/unit",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.0.0",
    "i18next": "^26.3.6",
    "maplibre-gl": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-router": "^7.8.0",
    "remixicon": "^4.9.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.10"
  }
}
