# Copy this file to .env.local after starting the local Supabase stack.
# Run `npm run supabase:status` to obtain the URL and anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key
# MapTiler is the selected hosted production provider for map tiles and
# geocoding (PS-110). This browser-visible key must be restricted to the
# development or production site origin in the MapTiler dashboard.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=replace-with-restricted-maptiler-key
