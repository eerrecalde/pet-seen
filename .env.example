# Copy this file to .env.local after starting the local Supabase stack.
# Run `npm run supabase:status` to obtain the URL and anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key
# Optional during development. PS-110 selects the production tile and geocoding provider.
# VITE_MAP_STYLE_URL=https://maps.example.com/styles/pet-seen.json
