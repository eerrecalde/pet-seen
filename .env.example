# Copy this file to .env.local after starting the local Supabase stack.
# Run `npm run supabase:status` to obtain the URL and anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key
# Public URL of the deployed case-social-card Edge Function. It creates the
# Open Graph image from the same public-safe projection used by the app.
# VITE_SOCIAL_CARD_URL=https://your-project.supabase.co/functions/v1/case-social-card
# Set these as Supabase Edge Function secrets before deploying
# send-sighting-owner-email. Use a verified sender address with Resend.
# RESEND_API_KEY=re_...
# SIGHTING_EMAIL_FROM=Pet Seen <alerts@petseen.org>
# Automated found-pet safety screening. Set these as Supabase Edge Function
# secrets; never expose the key in a VITE_ browser variable.
# CONTENT_SAFETY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MapTiler is the selected hosted production provider for map tiles and
# geocoding (PS-110). This browser-visible key must be restricted to the
# development or production site origin in the MapTiler dashboard.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=replace-with-restricted-maptiler-key
